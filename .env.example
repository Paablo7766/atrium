# Financial Modeling Prep — server-only (proxy /api/quotes + /api/logo)
# Get a free key at https://site.financialmodelingprep.com/developer/docs
# Prefer FMP_API_KEY (never bundled into the client).
# VITE_FMP_API_KEY still works as a fallback for the proxy / Vite middleware.
FMP_API_KEY=

# Supabase (Auth + Postgres). Create a project at https://supabase.com
# Without these, the app runs in local-only mode (no Login gate).
# Vite exposes only VITE_* vars to the client.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
