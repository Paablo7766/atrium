# Financial Modeling Prep — server-only (proxy /api/quotes + /api/logo)
# Get a free key at https://site.financialmodelingprep.com/developer/docs
# Prefer FMP_API_KEY (never bundled into the client).
# VITE_FMP_API_KEY still works as a fallback for the Vite dev middleware only.
FMP_API_KEY=

# Beta feedback → Discord (solo servidor: api/feedback.ts en Vercel).
# Crea un webhook en tu canal de Discord y pega la URL aquí y en Vercel.
DISCORD_FEEDBACK_WEBHOOK_URL=
# Opcional: límite por IP en api/feedback (default 5 peticiones / 60 s).
# FEEDBACK_RATE_LIMIT_MAX=5
# FEEDBACK_RATE_LIMIT_WINDOW_SEC=60

# URL pública de la web en Vercel (sin barra final). Obligatoria al compilar la app de
# escritorio para que «Enviar sugerencia o error» pueda llamar a /api/feedback.
# En la web desplegada en Vercel no hace falta (usa el mismo origen).
# VITE_ATRIUM_PUBLIC_ORIGIN=https://tu-app.vercel.app

# Optional: comma-separated origins allowed to call /api/* (default: same-origin / * in local).
# Example: https://your-app.vercel.app,http://localhost:5173
# ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Supabase — OPCIONAL (sync multi-dispositivo cifrado E2E)
# -----------------------------------------------------------------------------
# Atrium funciona al 100 % sin estas variables: el diario vive en SQLite cifrado
# (escritorio) o localStorage (web). Si las defines, el usuario puede activar
# «Sync multi-dispositivo» en Ajustes › Datos; los datos se cifran en el cliente
# antes de subir (tabla encrypted_sync_snapshots). Nunca pongas service_role aquí.
# Migraciones: supabase/migrations/001 … 005_sync_salt.sql
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Google Drive (selector dentro de Atrium en web/móvil) — OPCIONAL
# -----------------------------------------------------------------------------
# Consola Google Cloud: activa Drive API + Picker API. Crea credenciales OAuth «Web»
# con origen https://tu-app.vercel.app y la API key restringida a Picker + Drive.
# Sin esto, en móvil solo queda «Elegir en este dispositivo».
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
# Número del proyecto (Google Cloud → Panel), opcional pero recomendado para Picker.
VITE_GOOGLE_APP_ID=
